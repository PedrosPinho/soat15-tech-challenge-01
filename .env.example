# Application
NODE_ENV=development
PORT=3001
API_PREFIX=/api

# Database (PostgreSQL)
POSTGRES_USER=oficina
POSTGRES_PASSWORD=senha123
POSTGRES_DB_NAME=oficina
DATABASE_URL=postgres://oficina:senha123@localhost:5432/oficina

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10
WEBHOOK_SECRET=your-webhook-secret-change-this-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS
CORS_ORIGIN=http://localhost:3001

# Notificações — "smtp" (Nodemailer/Mailhog, default local) ou "ses" (Amazon SES)
NOTIFICATION_PROVIDER=smtp

# SMTP (usado quando NOTIFICATION_PROVIDER=smtp)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@oficina.com

# Amazon SES (usado quando NOTIFICATION_PROVIDER=ses)
AWS_REGION=us-east-1
SES_FROM_EMAIL=no-reply@oficina.com

# SonarQube (obter após primeiro login em http://localhost:9000)
SONAR_TOKEN=your-sonarqube-token
