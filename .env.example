# Application
NODE_ENV=development
PORT=3001
API_PREFIX=/api

# Database (MongoDB — em fase de substituição pelo PostgreSQL na Fase 3)
MONGODB_USER=admin
MONGODB_PASSWORD=senha123
MONGODB_DB_NAME=oficina
MONGODB_URI=mongodb://admin:senha123@localhost:27017/oficina?authSource=admin

# Database (PostgreSQL — Fase 3, coexistindo com o MongoDB até a migração terminar)
POSTGRES_USER=oficina
POSTGRES_PASSWORD=senha123
POSTGRES_DB_NAME=oficina
DATABASE_URL=postgres://oficina:senha123@localhost:5432/oficina

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10
WEBHOOK_SECRET=your-webhook-secret-change-this-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS
CORS_ORIGIN=http://localhost:3001

# SMTP (notificação de atualização de status por e-mail)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@oficina.com

# SonarQube (obter após primeiro login em http://localhost:9000)
SONAR_TOKEN=your-sonarqube-token
